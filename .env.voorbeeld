# Voorbeeld voor het bestand ".env" (de sleutels van Mozilla).
#
# Zo gebruik je het:
#   1. Maak in deze map een kopie van dit bestand en noem die:  .env
#   2. Plak achter de = tekens jouw twee sleutels van addons.mozilla.org
#      (zonder spaties en zonder aanhalingstekens).
#   3. Bewaar het bestand.
#
# Het bestand .env komt NOOIT op GitHub: het staat in .gitignore.
# Deel de sleutels met niemand en plak ze niet in een chat.

# De "JWT issuer" (begint meestal met user:)
WEB_EXT_API_KEY=

# De "JWT secret" (een lange rij letters en cijfers)
WEB_EXT_API_SECRET=
