{
  "manifest_version": 3,
  "name": "Sean's Karaoke Show",
  "short_name": "Karaoke Show",
  "version": "0.3.0",
  "description": "Maakt van je laptop een karaoke-regiepaneel en van een tweede scherm een karaokescherm.",
  "icons": {
    "48": "iconen/icoon.svg",
    "96": "iconen/icoon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "seans-karaoke-show@karafox",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "menus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "achtergrond/achtergrond.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "pop-up/pop-up.js"
      ],
      "css": [
        "gedeeld/lettertypes.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gedeeld/huisstijl.css",
        "gedeeld/lettertypes.css",
        "pop-up/pop-up.css",
        "lettertypes/*.ttf"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Karaoke-regiepaneel openen of sluiten",
    "default_icon": "iconen/icoon.svg",
    "default_area": "navbar"
  },
  "sidebar_action": {
    "default_title": "Sean's Karaoke Show",
    "default_panel": "zijbalk/zijbalk.html",
    "default_icon": "iconen/icoon.svg",
    "open_at_install": true
  }
}
