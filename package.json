{
  "name": "seans-karaoke-show",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox-extensie die van je laptop een karaoke-regiepaneel maakt en van een tweede scherm een karaokescherm.",
  "type": "module",
  "scripts": {
    "start": "web-ext run",
    "test": "node --test \"tests/**/*.test.js\"",
